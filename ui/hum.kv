#:import dp kivy.metrics.dp
#:set ACCENT (0.88, 0.36, 0.15, 1)
#:set ACCENT_DOWN (0.69, 0.23, 0.13, 1)
#:set RED (0.83, 0.23, 0.19, 1)
#:set DARK (0.08, 0.055, 0.055, 1)
#:set SURFACE (0.18, 0.12, 0.11, 1)
#:set SURFACE_DOWN (0.28, 0.17, 0.14, 1)
#:set TEXT (0.94, 0.88, 0.82, 1)
#:set MUTED (0.64, 0.55, 0.51, 1)

<AccentButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0.16, 0.12, 0.12, 1) if self.disabled else ((RED if self.text == 'Stop' else ACCENT) if self.text in ('Record', 'Re-record', 'Stop') else (SURFACE if self.state == 'normal' else SURFACE_DOWN))
    color: TEXT
    disabled_color: MUTED
    bold: True
    font_size: '18sp'
    size_hint_y: None
    height: dp(52)

<EditButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (0.14, 0.11, 0.11, 1) if self.disabled else (SURFACE if self.state == 'normal' else SURFACE_DOWN)
    color: MUTED if self.disabled else TEXT
    size_hint: None, None
    size: dp(88), dp(40)
    font_size: '15sp'

<DarkSpinner@Spinner>:
    background_normal: ''
    background_color: SURFACE
    color: TEXT
    size_hint_y: None
    height: dp(48)
    font_size: '18sp'

<TrackToggle@ToggleButton>:
    background_normal: ''
    background_down: ''
    background_color: ACCENT_DOWN if self.state == 'down' else SURFACE
    color: TEXT if self.state == 'down' else (0.78, 0.71, 0.67, 1)
    size_hint_y: None
    height: dp(48)
    font_size: '16sp'

<MainScreen>:
    canvas.before:
        Color:
            rgba: 0.075, 0.052, 0.054, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(14)
        spacing: dp(10)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Label:
                text: 'Hum2Band'
                font_size: '26sp'
                bold: True
                color: ACCENT
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            Label:
                text: root.chords_text
                font_size: '18sp'
                color: (0.78, 0.68, 0.62, 1)
            Label:
                text: root.key_text
                font_size: '21sp'
                bold: True
                color: TEXT
                halign: 'right'
                valign: 'middle'
                text_size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(8)
            EditButton:
                text: 'Undo'
                disabled: not root.can_undo
                on_release: root.on_undo()
            EditButton:
                text: 'Redo'
                disabled: not root.can_redo
                on_release: root.on_redo()
            EditButton:
                text: 'Select all'
                disabled: not root.can_edit
                on_release: root.on_select_all()
            EditButton:
                text: 'Delete'
                disabled: not root.can_edit
                on_release: root.on_delete_notes()
            DarkSpinner:
                text: 'Grid: 1/8'
                values: root.grid_choices
                size_hint_x: None
                width: dp(120)
                height: dp(40)
                font_size: '15sp'
                on_text: root.on_grid(self.text)
            TrackToggle:
                text: 'Snap to key'
                size_hint_x: None
                width: dp(124)
                height: dp(40)
                font_size: '15sp'
                state: 'down' if root.scale_lock else 'normal'
                on_state: root.on_scale_lock(self.state == 'down')
            Label:
                text: root.edit_hint
                font_size: '11sp'
                shorten: True
                shorten_from: 'right'
                max_lines: 2
                color: MUTED
                halign: 'left'
                valign: 'middle'
                text_size: self.size
        NoteStrip:
            id: note_strip
            editable: root.can_edit
            edit_callback: root.on_edit_commit
            preview_callback: root.on_preview_note
        ProgressBar:
            size_hint_y: None
            height: dp(8)
            max: 1
            value: root.progress
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(12)
            Widget:
                size_hint_x: None
                width: dp(28)
                canvas:
                    Color:
                        rgba: RED if root.is_recording else (0.35, 0.23, 0.20, 1)
                    Ellipse:
                        pos: self.x + dp(4), self.center_y - dp(10)
                        size: dp(20), dp(20)
            Label:
                text: root.live_note
                font_size: '30sp'
                bold: True
                size_hint_x: None
                width: dp(90)
            ProgressBar:
                max: 1
                value: root.level
                size_hint_x: 0.5
            Label:
                text: root.status_text
                font_size: '18sp'
                color: RED if root.state == 'error' else TEXT
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                size_hint_x: 1.5
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)
            AccentButton:
                text: root.record_text
                disabled: not root.can_record
                on_release: root.on_record()
            AccentButton:
                text: root.play_text
                disabled: not root.can_play
                on_release: root.on_play_stop()
            AccentButton:
                text: 'Try demo'
                disabled: not root.can_record
                on_release: root.on_demo()
            AccentButton:
                text: 'Save WAV'
                disabled: not root.can_play
                on_release: root.on_save()
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            DarkSpinner:
                text: 'Pop'
                values: ['Pop', 'Lo-fi', 'Rock', 'Funk', 'Hip-hop', 'Electronic']
                on_text: root.on_genre(self.text)
            Label:
                text: '%d BPM' % tempo.value
                size_hint_x: None
                width: dp(90)
                font_size: '18sp'
            Slider:
                id: tempo
                min: 60
                max: 160
                step: 1
                value: 100
                on_value: root.on_tempo(self.value)
            DarkSpinner:
                text: 'Key: Auto'
                values: root.key_choices
                on_text: root.on_key_override(self.text)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            DarkSpinner:
                text: root.bass_style_text
                values: root.bass_style_choices
                on_text: root.on_bass_style(self.text)
            DarkSpinner:
                text: root.drum_style_text
                values: root.drum_style_choices
                on_text: root.on_drum_style(self.text)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            DarkSpinner:
                id: in_dev
                text: root.default_in
                values: root.input_names
                on_text: root.on_input_device(self.text)
            DarkSpinner:
                id: out_dev
                text: root.default_out
                values: root.output_names
                on_text: root.on_output_device(self.text)
            Button:
                text: 'Refresh audio'
                size_hint_x: None
                width: dp(140)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: SURFACE
                color: TEXT
                on_release: root.on_refresh()
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            Label:
                text: 'Mic gain'
                size_hint_x: None
                width: dp(90)
                color: MUTED
            Slider:
                min: 0.25
                max: 12
                value: 2
                size_hint_x: 1
                on_value: root.on_gain(self.value)
            Label:
                text: 'Max hum'
                size_hint_x: None
                width: dp(80)
                color: MUTED
            Slider:
                min: 5
                max: 45
                step: 1
                value: 45
                size_hint_x: 1
                on_value: root.set_record_limit(self.value)
            Label:
                text: root.record_limit_text
                size_hint_x: None
                width: dp(40)
                font_size: '15sp'
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            TrackToggle:
                text: 'Melody'
                state: 'down'
                on_state: root.on_track('melody', self.state == 'down')
            TrackToggle:
                text: 'Chords'
                state: 'down'
                on_state: root.on_track('chords', self.state == 'down')
            TrackToggle:
                text: 'Bass'
                state: 'down'
                on_state: root.on_track('bass', self.state == 'down')
            TrackToggle:
                text: 'Drums'
                state: 'down'
                on_state: root.on_track('drums', self.state == 'down')
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)
            AccentButton:
                text: 'Play Hum Reference'
                disabled: not root.can_reference
                font_size: '16sp'
                height: dp(44)
                on_release: root.on_play_reference()
            AccentButton:
                text: 'Save Hum Reference'
                disabled: not root.can_reference
                font_size: '16sp'
                height: dp(44)
                on_release: root.on_save_reference()
            TrackToggle:
                text: 'Hum + Band'
                state: 'down' if root.reference_with_band else 'normal'
                disabled: not root.can_reference
                font_size: '15sp'
                height: dp(44)
                on_state: root.on_reference_mix(self.state == 'down')
    Label:
        text: root.big_text
        font_size: '180sp'
        bold: True
        color: 1, 1, 1, 0.92
        size_hint: None, None
        size: dp(300), dp(300)
        pos_hint: {'center_x': .5, 'center_y': .58}
